#!/usr/bin/env python3
import sys
import json
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent / "lib"))
from markdown_generator import MarkdownGenerator
from youtube_extractor import VideoMetadata, ChapterInfo
def main():
    try:
        input_data = json.load(sys.stdin)
        metadata = VideoMetadata(**input_data['metadata'])
        chapters = [ChapterInfo(**chap) for chap in input_data['chapters']]
        transcript_path = Path(input_data['transcript_path']) if input_data['transcript_path'] else None
        output_dir = Path(input_data['output_directory'])
        print("Generating structured markdown...", file=sys.stderr)
        markdown_generator = MarkdownGenerator()
        markdown_content = markdown_generator.generate_structured_markdown(
            metadata, chapters, transcript_path
        )
        markdown_path = output_dir / 'structured_content.md'
        markdown_generator.save_markdown(markdown_content, markdown_path)
        print(f"Markdown file saved to: {markdown_path}", file=sys.stderr)
        print(json.dumps(input_data, indent=2, ensure_ascii=False))
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
if __name__ == "__main__":
    main()
